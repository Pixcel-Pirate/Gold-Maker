{
  "applicationId": "app.goldsmithsledger.desktop",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 52731,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "The Goldsmith's Ledger",
      "width": 1280,
      "height": 900,
      "minWidth": 900,
      "minHeight": 640,
      "center": true,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "injectGlobals": true,
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryName": "GoldsmithsLedger",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "clientLibrary": "/resources/js/neutralino.js"
  },
  "nativeAllowList": [
    "filesystem.writeBinaryFile",
    "os.execCommand",
    "app.exit",
    "app.restartProcess"
  ]
}
